# TaskFlow API base (Next.js). Use your machine LAN IP for a physical device / Expo Go.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Web app origin for "Open in TaskFlow", email verify, forgot password, sketch edit.
EXPO_PUBLIC_APP_URL=http://localhost:3000

# Supabase (realtime) — same public values as apps/web
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
