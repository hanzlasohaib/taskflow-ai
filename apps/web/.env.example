# TaskFlow Web — environment variables
# Copy to apps/web/.env.local and fill in real values. Never commit secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
# Use the pooled connection string for DATABASE_URL (often port 6543 / pgBouncer).
# Use the direct connection string for DIRECT_URL (migrations; often port 5432 / db.<project>.supabase.co).
# Prefer appending sslmode=require. For pooler: ?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL=
DIRECT_URL=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra trusted origins (Chrome MV3 popup, Expo LAN API, etc.).
# After loading the unpacked extension, copy its ID from chrome://extensions and add:
# BETTER_AUTH_TRUSTED_ORIGINS=chrome-extension://<extension-id>
# Stable ID with the key in apps/extension: chrome-extension://akjpgdhgfhpppafgdfhaebceaklfgjcc
# For Expo Go on a device, also add your LAN API origin if sign-in is blocked, e.g. http://192.168.1.10:3000
BETTER_AUTH_TRUSTED_ORIGINS=chrome-extension://akjpgdhgfhpppafgdfhaebceaklfgjcc

# Resend
RESEND_API_KEY=
EMAIL_FROM="TaskFlow <onboarding@resend.dev>"

# Google reCAPTCHA v3
# Safe to keep production keys in local `.env` for Vercel sync — captcha is
# skipped automatically in `next dev`. Set RECAPTCHA_FORCE=true to test locally
# (also add localhost in the Google reCAPTCHA admin domain list).
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_FORCE=true
# NEXT_PUBLIC_RECAPTCHA_FORCE=true

# Deepgram (voice STT — server-only; never NEXT_PUBLIC_)
DEEPGRAM_API_KEY=

# Supabase (realtime / storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret from Supabase Project Settings → API (used to mint Realtime JWTs; never expose to client)
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storage
# Avatars bucket (public read; server uploads with service role)
AVATARS_BUCKET=avatars
# Sketch PNG thumbnails (private bucket; path only in DB)
BLOB_OR_STORAGE_BUCKET=sketches
