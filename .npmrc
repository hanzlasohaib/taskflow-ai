# Prefer a single React at the workspace root for Next.js web builds.
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=scheduler

# Expo / Metro need these reachable from apps/mobile (pnpm isolation).
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*

# Keep Prisma client resolvable after installs (generated files live under @prisma/client).
public-hoist-pattern[]=@prisma/client
public-hoist-pattern[]=prisma